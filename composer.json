{
    "name": "hydrakit/hydra",
    "description": "Hydra PHP framework development monorepo. Install the individual hydrakit/* packages, not this.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.0",
        "php-di/php-di": "^7.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "replace": {
        "hydrakit/admin": "self.version",
        "hydrakit/auth": "self.version",
        "hydrakit/authorization": "self.version",
        "hydrakit/cache": "self.version",
        "hydrakit/console": "self.version",
        "hydrakit/core": "self.version",
        "hydrakit/csrf": "self.version",
        "hydrakit/database": "self.version",
        "hydrakit/event": "self.version",
        "hydrakit/http": "self.version",
        "hydrakit/kernel": "self.version",
        "hydrakit/log": "self.version",
        "hydrakit/nyholm": "self.version",
        "hydrakit/php-di": "self.version",
        "hydrakit/session": "self.version",
        "hydrakit/validation": "self.version",
        "hydrakit/view": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Hydra\\Admin\\": "packages/admin/src",
            "Hydra\\Auth\\": "packages/auth/src",
            "Hydra\\Authorization\\": "packages/authorization/src",
            "Hydra\\Cache\\": "packages/cache/src",
            "Hydra\\Console\\": "packages/console/src",
            "Hydra\\Core\\": "packages/core/src",
            "Hydra\\Csrf\\": "packages/csrf/src",
            "Hydra\\Database\\": "packages/database/src",
            "Hydra\\Event\\": "packages/event/src",
            "Hydra\\Http\\": "packages/http/src",
            "Hydra\\Kernel\\": "packages/kernel/src",
            "Hydra\\Log\\": "packages/log/src",
            "Hydra\\Nyholm\\": "packages/nyholm/src",
            "Hydra\\PhpDi\\": "packages/php-di/src",
            "Hydra\\Session\\": "packages/session/src",
            "Hydra\\Validation\\": "packages/validation/src",
            "Hydra\\View\\": "packages/view/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hydra\\Admin\\Tests\\": "packages/admin/tests",
            "Hydra\\Auth\\Tests\\": "packages/auth/tests",
            "Hydra\\Authorization\\Tests\\": "packages/authorization/tests",
            "Hydra\\Cache\\Tests\\": "packages/cache/tests",
            "Hydra\\Console\\Tests\\": "packages/console/tests",
            "Hydra\\Core\\Tests\\": "packages/core/tests",
            "Hydra\\Csrf\\Tests\\": "packages/csrf/tests",
            "Hydra\\Database\\Tests\\": "packages/database/tests",
            "Hydra\\Event\\Tests\\": "packages/event/tests",
            "Hydra\\Http\\Tests\\": "packages/http/tests",
            "Hydra\\Kernel\\Tests\\": "packages/kernel/tests",
            "Hydra\\Log\\Tests\\": "packages/log/tests",
            "Hydra\\Nyholm\\Tests\\": "packages/nyholm/tests",
            "Hydra\\PhpDi\\Tests\\": "packages/php-di/tests",
            "Hydra\\Session\\Tests\\": "packages/session/tests",
            "Hydra\\Validation\\Tests\\": "packages/validation/tests",
            "Hydra\\View\\Tests\\": "packages/view/tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    },
    "scripts": {
        "stan": "phpstan analyse",
        "lint": "php-cs-fixer check --diff",
        "lint:fix": "php-cs-fixer fix",
        "test": "phpunit --order-by=random",
        "qa": [
            "@stan",
            "@lint",
            "@test"
        ]
    }
}
