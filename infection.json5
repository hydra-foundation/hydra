{
    // Mutation testing over four packages, not the tree.
    //
    // Coverage says a line ran; this says a test would have noticed it change.
    // Mutating all 2400 lines would take long enough that it would be run
    // never, so it is pointed at the places where a test that passes against
    // broken code costs the most: the validation rules, the rate limiter and
    // the client-address resolver it keys on, the HTTP layer every request
    // passes through, and the storage keys that stand between an upload and a
    // path on disk.
    $schema: "tools/infection/vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "packages/validation/src",
            "packages/throttle/src",
            "packages/http/src",
            "packages/filesystem/src"
        ],
        // Relative to each directory above, not to the root: written as
        // packages/*/src/Testing it matched nothing, and went unnoticed only
        // while phpunit.xml kept src/Testing out of coverage.
        excludes: [
            "Testing"
        ]
    },
    timeout: 10,
    logs: {
        text: "build/infection.log"
    },
    tmpDir: "build/infection",
    // A floor, recorded the way coverage.json records one: the number reached
    // today, so the next change has to hold it rather than aim at it. Raised
    // deliberately when a batch of survivors is worked through, never lowered
    // to make a build pass.
    //
    // minMsi is left off. It counts uncovered code as unkilled, and coverage
    // already has a gate of its own that says so more directly.
    minCoveredMsi: 89,
    mutators: {
        "@default": true
    },
    phpUnit: {
        configDir: "."
    }
}
