{
    "name": "hydrakit/seo",
    "description": "Meta tags, sitemaps and Atom feeds for Hydra: built from plain values, escaped once, every URL absolute.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://hydra.williamhleucka.com",
    "autoload": {
        "psr-4": {
            "Hydra\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hydra\\Seo\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../core", "options": { "symlink": true } },
        { "type": "path", "url": "../http", "options": { "symlink": true } },
        { "type": "path", "url": "../session", "options": { "symlink": true } },
        { "type": "path", "url": "../csrf", "options": { "symlink": true } },
        { "type": "path", "url": "../view", "options": { "symlink": true } }
    ],
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "hydrakit/view": "^0.27",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.27.x-dev"
        }
    }
}
