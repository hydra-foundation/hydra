{
    "name": "hydrakit/authorization",
    "description": "Ability-based authorization for Hydra, on top of hydrakit/auth.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Hydra\\Authorization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hydra\\Authorization\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../core", "options": { "symlink": true } },
        { "type": "path", "url": "../http", "options": { "symlink": true } },
        { "type": "path", "url": "../session", "options": { "symlink": true } },
        { "type": "path", "url": "../auth", "options": { "symlink": true } }
    ],
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "hydrakit/core": "^0.5",
        "hydrakit/http": "^0.5",
        "hydrakit/auth": "^0.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    }
}
