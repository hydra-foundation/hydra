{
    "name": "hydrakit/filesystem",
    "description": "File storage behind one contract: a private disk served through the app, a public disk served by the web server, and keys that never trust the client's filename.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://hydra.williamhleucka.com",
    "autoload": {
        "psr-4": {
            "Hydra\\Filesystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hydra\\Filesystem\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../core", "options": { "symlink": true } },
        { "type": "path", "url": "../console", "options": { "symlink": true } }
    ],
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "hydrakit/core": "^0.10",
        "hydrakit/console": "^0.10",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    }
}
