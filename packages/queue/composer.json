{
    "name": "hydrakit/queue",
    "description": "Work that outlives the request: a job contract, a database queue with retries, drained by the scheduler.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://hydra.williamhleucka.com",
    "autoload": {
        "psr-4": {
            "Hydra\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hydra\\Queue\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../console",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../database",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../validation",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../scheduler",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../log",
            "options": {
                "symlink": true
            }
        }
    ],
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "hydrakit/core": "^0.30",
        "hydrakit/console": "^0.30",
        "hydrakit/database": "^0.30",
        "hydrakit/scheduler": "^0.30",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "hydrakit/log": "^0.30",
        "hydrakit/event": "^0.30",
        "ext-pdo_sqlite": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.30.x-dev"
        }
    }
}
