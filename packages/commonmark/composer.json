{
    "name": "hydrakit/commonmark",
    "description": "CommonMark adapter: Markdown to safe HTML for Hydra, with front matter and server-side code highlighting.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://hydra.williamhleucka.com",
    "autoload": {
        "psr-4": {
            "Hydra\\CommonMark\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hydra\\CommonMark\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../core", "options": { "symlink": true } },
        { "type": "path", "url": "../http", "options": { "symlink": true } },
        { "type": "path", "url": "../session", "options": { "symlink": true } },
        { "type": "path", "url": "../validation", "options": { "symlink": true } },
        { "type": "path", "url": "../csrf", "options": { "symlink": true } },
        { "type": "path", "url": "../view", "options": { "symlink": true } }
    ],
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "hydrakit/core": "^0.28",
        "hydrakit/view": "^0.28",
        "league/commonmark": "^2.7",
        "symfony/yaml": "^7.0",
        "tempest/highlight": "^2.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.28.x-dev"
        }
    }
}
