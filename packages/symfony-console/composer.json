{
    "name": "hydrakit/symfony-console",
    "description": "Symfony Console adapter: the default runner for Hydra commands, and the only package that names it.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://hydra.williamhleucka.com",
    "autoload": {
        "psr-4": {
            "Hydra\\SymfonyConsole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hydra\\SymfonyConsole\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../console",
            "options": {
                "symlink": true
            }
        }
    ],
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "hydrakit/console": "^0.7",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.7.x-dev"
        }
    }
}
