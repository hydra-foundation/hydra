{
    "name": "hydrakit/admin",
    "description": "A composable admin backend for Hydra apps: declare a module, get routes and htmx screens.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://hydra.williamhleucka.com",
    "autoload": {
        "psr-4": {
            "Hydra\\Admin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hydra\\Admin\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../http",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../view",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../auth",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../authorization",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../session",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../csrf",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../event",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../validation",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../database",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../cache",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../console",
            "options": {
                "symlink": true
            }
        }
    ],
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "hydrakit/core": "^0.8",
        "hydrakit/database": "^0.8",
        "hydrakit/http": "^0.8",
        "hydrakit/validation": "^0.8",
        "hydrakit/view": "^0.8",
        "hydrakit/authorization": "^0.8",
        "hydrakit/cache": "^0.8",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "hydrakit/console": "^0.8"
    },
    "require-dev": {
        "hydrakit/event": "^0.8",
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        }
    }
}
