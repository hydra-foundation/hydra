{
    "name": "hydrakit/image",
    "description": "Image variants for Hydra: a picture resized to the widths a page needs, as WebP, upright and without metadata.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://hydra.williamhleucka.com",
    "autoload": {
        "psr-4": {
            "Hydra\\Image\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hydra\\Image\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../http",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../session",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../csrf",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../view",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../console",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../filesystem",
            "options": {
                "symlink": true
            }
        }
    ],
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-gd": "*",
        "ext-exif": "*",
        "hydrakit/core": "^0.30",
        "hydrakit/console": "^0.30",
        "hydrakit/filesystem": "^0.30",
        "hydrakit/view": "^0.30",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.30.x-dev"
        }
    }
}
