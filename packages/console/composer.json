{
    "name": "hydrakit/console",
    "description": "The generic console commands every Hydra app needs, and the contracts a command is written against.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://hydra.williamhleucka.com",
    "autoload": {
        "psr-4": {
            "Hydra\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hydra\\Console\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../http",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../database",
            "options": {
                "symlink": true
            }
        }
    ],
    "authors": [
        {
            "name": "William Hleucka",
            "email": "william.hleucka@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "hydrakit/http": "^0.7",
        "hydrakit/database": "^0.7",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "ext-pdo_sqlite": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.7.x-dev"
        }
    }
}
